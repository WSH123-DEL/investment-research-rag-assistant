"""
══════════════════════════════════════════════════════════════
  具身智能赛道投资研报问答助手  v2.2
  LangChain 1.x 原生写法

  技术栈:
    - LLM:    DeepSeek V4 (via ChatDeepSeek)
    - 嵌入:    shibing624/text2vec-base-chinese
    - 向量库:  Chroma
    - 链:      LCEL (LangChain Expression Language)
    - 前端:    Gradio

  特性:
    - 可信度标签 (JSON 输出 + 颜色)
    - 多轮对话   (带历史感知检索)
    - 数据脱敏   (身份证/手机号/银行卡)
══════════════════════════════════════════════════════════════
"""

import os
import shutil
import json
import re
import sys
import threading
from pathlib import Path

from dotenv import load_dotenv
import gradio as gr
from pypdf import PdfReader

# ── LangChain 1.x 独立集成包 ──
from langchain_deepseek import ChatDeepSeek
from langchain_text_splitters import RecursiveCharacterTextSplitter
from langchain_huggingface import HuggingFaceEmbeddings
from langchain_chroma import Chroma
from langchain_classic.chains import (
    create_history_aware_retriever,
    create_retrieval_chain,
)
from langchain_classic.chains.combine_documents import create_stuff_documents_chain
from langchain_core.documents import Document
from langchain_core.messages import AIMessage, HumanMessage
from langchain_core.prompts import ChatPromptTemplate, MessagesPlaceholder, PromptTemplate

# ═══════════════════════════════════════════════════════════════
#  配置
# ═══════════════════════════════════════════════════════════════

BASE_DIR = Path(__file__).parent.resolve()
PDF_DIR = BASE_DIR / "data"
CHROMA_DB_DIR = BASE_DIR / "chroma_db"

# 始终读取 main.py 同目录下的 .env，不再依赖 PyCharm 的工作目录。
ENV_FILE = BASE_DIR / ".env"
load_dotenv(ENV_FILE)

DEEPSEEK_API_KEY = (os.getenv("DEEPSEEK_API_KEY") or "").strip()
DEEPSEEK_BASE_URL = (os.getenv("DEEPSEEK_BASE_URL") or "https://api.deepseek.com").strip()
DEEPSEEK_MODEL = (os.getenv("DEEPSEEK_MODEL") or "deepseek-v4-flash").strip()
DEEPSEEK_THINKING = (os.getenv("DEEPSEEK_THINKING") or "disabled").strip().lower()
EMBEDDING_MODEL = (
    os.getenv("EMBEDDING_MODEL") or "shibing624/text2vec-base-chinese"
).strip()
EMBEDDING_DEVICE = (os.getenv("EMBEDDING_DEVICE") or "cpu").strip()

if not DEEPSEEK_API_KEY:
    raise RuntimeError(
        f"缺少 DEEPSEEK_API_KEY。请在 {ENV_FILE} 中配置："
        "DEEPSEEK_API_KEY=你的密钥"
    )

if DEEPSEEK_THINKING not in {"enabled", "disabled"}:
    raise ValueError("DEEPSEEK_THINKING 只能是 enabled 或 disabled")

# ═══════════════════════════════════════════════════════════════
#  初始化模型
# ═══════════════════════════════════════════════════════════════

# 嵌入模型按需加载：先让 Gradio 服务立即启动，避免旧页面在重启期间长时间
# 显示 “Connection to the server was lost”。首次处理 PDF 时才真正占用内存。
# 加载时优先使用本机 Hugging Face 缓存，缓存缺失才联网下载。
embeddings = None
_embeddings_lock = threading.Lock()


def _create_embeddings(*, local_files_only):
    return HuggingFaceEmbeddings(
        model_name=EMBEDDING_MODEL,
        model_kwargs={
            "device": EMBEDDING_DEVICE,
            "local_files_only": local_files_only,
        },
        encode_kwargs={"normalize_embeddings": True, "batch_size": 32},
    )


def get_embeddings():
    """线程安全地延迟初始化嵌入模型，并优先复用本地缓存。"""
    global embeddings

    if embeddings is not None:
        return embeddings

    with _embeddings_lock:
        if embeddings is not None:
            return embeddings

        print(f"加载中文嵌入模型: {EMBEDDING_MODEL} ...", flush=True)
        try:
            embeddings = _create_embeddings(local_files_only=True)
            print("嵌入模型已从本地缓存加载", flush=True)
        except Exception as cache_error:
            print(
                "本地缓存不完整，将从 Hugging Face 下载模型："
                f"{cache_error}",
                flush=True,
            )
            embeddings = _create_embeddings(local_files_only=False)
            print("嵌入模型下载并加载完成", flush=True)

        return embeddings

# 使用 DeepSeek 的 LangChain 原生集成；避免 ChatOpenAI 错查 OPENAI_API_KEY。
# V4 默认开启思考模式；本项目是低延迟、严格 JSON 的 RAG，因此默认关闭，
# 仍可在 .env 中通过 DEEPSEEK_THINKING=enabled 开启。
print(f"初始化 DeepSeek 模型: {DEEPSEEK_MODEL} ...")
llm_options = {
    "model": DEEPSEEK_MODEL,
    "api_key": DEEPSEEK_API_KEY,
    "base_url": DEEPSEEK_BASE_URL,
    "max_tokens": 4096,
    "timeout": 90,
    "max_retries": 3,
    "extra_body": {"thinking": {"type": DEEPSEEK_THINKING}},
}
if DEEPSEEK_THINKING == "disabled":
    llm_options["temperature"] = 0.1

llm = ChatDeepSeek(**llm_options)
answer_llm = llm.bind(response_format={"type": "json_object"})
print("DeepSeek 客户端初始化完成")

# ═══════════════════════════════════════════════════════════════
#  LCEL 链：两阶段提示词
#  ═══════════════════════════════════════════════════════════════
#  阶段 1: 检索重写 — 结合对话历史，把当前问题改写成独立的检索查询
#  阶段 2: 回答生成 — 用检索到的文档 + JSON 格式约束生成回答
# ═══════════════════════════════════════════════════════════════

# ── 阶段1: 上下文重写提示词 ──
# 作用：把 "那第二家呢？" 这种依赖上文的问题，重写成独立可检索的查询
contextualize_system_prompt = """结合对话历史，把用户的最新问题改写成一句独立完整的问题。
不要回答用户的问题，只做改写。如果用户问题本身已独立完整，直接原样返回。"""

contextualize_prompt = ChatPromptTemplate.from_messages([
    ("system", contextualize_system_prompt),
    MessagesPlaceholder("chat_history"),
    ("human", "{input}"),
])

# ── 阶段2: 回答生成提示词 (JSON 格式 + 安全规则) ──
qa_system_prompt = """你是一位专业的具身智能赛道投资分析师。
请严格根据以下研报资料中的内容回答问题。

【重要：你必须输出 JSON 格式】
{{
  "answer": "你的回答文本",
  "sources": ["文件名（第X页）"],
  "confidence": 0.0
}}

confidence 规则:
 1.0 = 所有数据都能在资料中找到
 0.7 = 大部分能找到，少部分合理推断
 0.4 = 仅有间接参考
 0.0 = 完全找不到 → answer 必须写"抱歉，基于现有文档无法回答此问题"

安全规则:
- 不提供投资建议，不预测股价
- 无确切来源的数据标"（未经验证）"
- 只输出 JSON，不要其他文字

【参考资料】
{context}"""

qa_prompt = ChatPromptTemplate.from_messages([
    ("system", qa_system_prompt),
    MessagesPlaceholder("chat_history"),
    ("human", "{input}"),
])

# 把真实文件名和页码一并交给模型，避免模型凭空编造来源。
document_prompt = PromptTemplate.from_template(
    "【来源文件】{source}\n【页码】第 {page} 页\n【正文】\n{page_content}"
)

# ═══════════════════════════════════════════════════════════════
#  数据脱敏
# ═══════════════════════════════════════════════════════════════

def desensitize(text):
    if not text:
        return text
    text = re.sub(
        r'[1-9]\d{5}(?:19|20)\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])\d{3}[\dXx]',
        '[已脱敏-身份证号]', text)
    text = re.sub(r'1[3-9]\d{9}', '[已脱敏-手机号]', text)
    text = re.sub(r'(?<!\d)\d{16,19}(?!\d)', '[已脱敏-银行卡号]', text)
    return text

# ═══════════════════════════════════════════════════════════════
#  向量数据库构建
# ═══════════════════════════════════════════════════════════════


def load_pdf_pages(pdf_path):
    """使用 pypdf 逐页读取 PDF，并转换成 LangChain Document。"""
    pdf_path = Path(pdf_path)
    reader = PdfReader(str(pdf_path))
    page_labels = getattr(reader, "page_labels", [])
    documents = []

    for page_index, page in enumerate(reader.pages):
        try:
            text = (page.extract_text() or "").strip()
        except Exception as exc:
            print(f"    第 {page_index + 1} 页读取失败: {exc}")
            continue

        if not text:
            continue

        page_number = page_index + 1
        page_label = (
            str(page_labels[page_index])
            if page_index < len(page_labels)
            else str(page_number)
        )
        documents.append(
            Document(
                page_content=text,
                metadata={
                    "source": pdf_path.name,
                    "file_path": str(pdf_path),
                    "page": page_number,
                    "page_label": page_label,
                },
            )
        )

    return documents


def build_vector_store(pdf_folder_path):
    pdf_dir = Path(pdf_folder_path)
    pdf_files = sorted(pdf_dir.glob("*.pdf"), key=lambda path: path.name.lower())
    if not pdf_files:
        print(f"ERROR: {pdf_dir} 中没有 PDF 文件")
        return None

    print(f"找到 {len(pdf_files)} 个 PDF")
    all_documents = []
    for pf in pdf_files:
        print(f"  读取: {pf.name}")
        try:
            documents = load_pdf_pages(pf)
            all_documents.extend(documents)
            print(f"    有效文本页: {len(documents)}")
        except Exception as e:
            print(f"  失败: {e}")

    if not all_documents:
        print("ERROR: 所有 PDF 读取失败")
        return None

    text_splitter = RecursiveCharacterTextSplitter(
        chunk_size=500, chunk_overlap=50,
        separators=["\n\n", "\n", "。", "！", "？", "；", "，", " ", ""],
    )
    chunks = text_splitter.split_documents(all_documents)
    print(f"切割为 {len(chunks)} 个文本块")

    # 仅重建本应用的默认 collection，不再递归删除整个数据库目录。
    vs = Chroma(
        collection_name="langchain",
        embedding_function=get_embeddings(),
        persist_directory=str(CHROMA_DB_DIR),
    )
    vs.reset_collection()
    vs.add_documents(chunks)
    print(f"向量数据库就绪: {len(chunks)} 条记录")
    return vs

# ═══════════════════════════════════════════════════════════════
#  问答 (LCEL 链)
# ═══════════════════════════════════════════════════════════════

def answer_question(question, chat_history=None):
    global vector_store

    if not question or not question.strip():
        return "请输入问题。"

    safe_question = desensitize(question.strip())

    if vector_store is None:
        return "[ERROR] 请先上传 PDF 再提问"

    # ── 构建 LCEL 链 ──
    #  第1步: 历史感知检索器 → 把问题 + 历史重写成独立查询 → 去向量库检索
    retriever = vector_store.as_retriever(
        search_type="mmr",
        search_kwargs={"k": 6, "fetch_k": 20, "lambda_mult": 0.7},
    )
    history_aware_retriever = create_history_aware_retriever(
        llm, retriever, contextualize_prompt
    )

    #  第2步: 文档组装链 → 检索到的文档 + 用户问题 → 生成回答
    question_answer_chain = create_stuff_documents_chain(
        answer_llm,
        qa_prompt,
        document_prompt=document_prompt,
    )

    #  第3步: 串成完整 RAG 链
    rag_chain = create_retrieval_chain(history_aware_retriever, question_answer_chain)

    try:
        # 把对话历史转成 LangChain 消息格式
        lc_messages = []
        if chat_history:
            # 只保留最近 10 条消息，控制请求长度和费用；同时兼容旧版元组历史。
            for item in chat_history[-10:]:
                if isinstance(item, dict):
                    role = item.get("role")
                    content = str(item.get("content") or "")
                    if role == "user":
                        lc_messages.append(HumanMessage(content=desensitize(content)))
                    elif role == "assistant":
                        lc_messages.append(AIMessage(content=content))
                elif isinstance(item, (tuple, list)) and len(item) == 2:
                    lc_messages.append(HumanMessage(content=desensitize(str(item[0]))))
                    lc_messages.append(AIMessage(content=str(item[1])))

        result = rag_chain.invoke({
            "input": safe_question,
            "chat_history": lc_messages,
        })

        raw = result["answer"]

        # ── 解析 JSON ──
        json_match = re.search(r'\{[\s\S]*\}', raw)
        if json_match:
            try:
                parsed = json.loads(json_match.group(0))
                answer = str(parsed.get("answer") or raw)
                sources = parsed.get("sources", [])
                try:
                    confidence = float(parsed.get("confidence", 0.5))
                except (TypeError, ValueError):
                    confidence = 0.5
                if not isinstance(sources, list):
                    sources = []
            except (json.JSONDecodeError, TypeError):
                answer = raw; sources = []; confidence = 0.5
        else:
            answer = raw; sources = []; confidence = 0.5

        confidence = max(0.0, min(1.0, confidence))

        # ── 脱敏 ──
        answer = desensitize(answer)

        # ── 可信度标签 ──
        if confidence >= 0.7:
            tag = "🟢"
        elif confidence >= 0.4:
            tag = "🟡"
        else:
            tag = "🔴"

        full = f"{tag} 模型自评可信度：{confidence:.0%}\n\n{answer}"

        # ── 来源引用：优先采用检索器返回的真实元数据 ──
        sdocs = result.get("context", [])
        if sdocs:
            full += "\n\n---\n参考来源：\n"
            seen = set()
            for d in sdocs:
                fn = Path(str(d.metadata.get("source", "未知文件"))).name
                pn = d.metadata.get("page_label", d.metadata.get("page", "?"))
                key = (fn, str(pn))
                if key not in seen:
                    seen.add(key)
                    full += f"  {len(seen)}. {fn}（第 {pn} 页）\n"
        elif sources:
            full += "\n\n---\n模型报告的来源（未由检索元数据校验）：\n"
            for index, source in enumerate(sources, 1):
                full += f"  {index}. {source}\n"

        return full

    except Exception as e:
        msg = str(e)
        if "401" in msg or "Unauthorized" in msg:
            return "❌ DeepSeek API 密钥无效，请检查项目 .env。"
        if "402" in msg or "Insufficient Balance" in msg:
            return "❌ DeepSeek 账户余额不足。"
        if "timeout" in msg.lower():
            return "❌ DeepSeek 请求超时，请检查网络后重试。"
        return f"❌ 问答失败：{msg}"

# ═══════════════════════════════════════════════════════════════
#  Gradio 界面
# ═══════════════════════════════════════════════════════════════

vector_store = None

def process_pdfs(pdf_files):
    global vector_store
    if not pdf_files:
        return "请先上传 PDF"

    PDF_DIR.mkdir(exist_ok=True)
    copied = []
    for f in pdf_files:
        src = Path(f) if isinstance(f, str) else Path(f.name)
        dest = PDF_DIR / src.name
        shutil.copy2(str(src), str(dest))
        copied.append(dest.name)

    vector_store = build_vector_store(PDF_DIR)
    if vector_store:
        return f"OK 已处理 {len(copied)} 个文件:\n" + "\n".join(f"  {x}" for x in copied)
    return "处理失败，见终端日志"


def chat_respond(message, chat_state):
    if not message or not message.strip():
        return "", chat_state, chat_state

    history = list(chat_state or [])
    reply = answer_question(message, chat_history=history)
    history.extend([
        {"role": "user", "content": message},
        {"role": "assistant", "content": reply},
    ])
    return "", history, history


with gr.Blocks(title="具身智能研报问答助手") as demo:
    gr.Markdown(
        "# Robot 具身智能赛道 · 投资研报问答助手\n\n"
        f"**LangChain 1.x + LCEL + {DEEPSEEK_MODEL}**\n\n"
        "1. 左侧上传 PDF  2. 等待处理  3. 右侧提问"
    )

    chat_state = gr.State([])

    with gr.Row():
        with gr.Column(scale=1):
            gr.Markdown("### Upload")
            pdf_input = gr.File(label="Select PDF", file_types=[".pdf"], file_count="multiple")
            upload_btn = gr.Button("Process", variant="primary")
            upload_status = gr.Textbox(label="Status", lines=8, interactive=False)

        with gr.Column(scale=2):
            gr.Markdown("### Chat")
            chatbot = gr.Chatbot(label="Chat", height=500, layout="bubble")
            msg_input = gr.Textbox(
                label="Question",
                placeholder="e.g. 2024年融资最高的具身智能公司？",
                lines=2,
            )
            with gr.Row():
                clear_btn = gr.Button("Clear")
                submit_btn = gr.Button("Send", variant="primary")

    upload_btn.click(fn=process_pdfs, inputs=[pdf_input], outputs=[upload_status])

    submit_btn.click(
        fn=chat_respond,
        inputs=[msg_input, chat_state],
        outputs=[msg_input, chat_state, chatbot],
    )
    msg_input.submit(
        fn=chat_respond,
        inputs=[msg_input, chat_state],
        outputs=[msg_input, chat_state, chatbot],
    )
    clear_btn.click(
        fn=lambda: ("", [], []),
        inputs=None,
        outputs=[msg_input, chat_state, chatbot],
    )


if __name__ == "__main__":
    print("\n=== 具身智能研报问答助手 v2.2 (LCEL) ===")
    print(f"Python 解释器: {sys.executable}")
    print(f"项目目录: {BASE_DIR}")
    print("正在启动网页: http://127.0.0.1:7860", flush=True)
    demo.launch(
        server_name="127.0.0.1",
        server_port=7860,
        share=False,
        inbrowser=True,
        show_error=True,
        quiet=False,
        theme=gr.themes.Soft(),
    )
